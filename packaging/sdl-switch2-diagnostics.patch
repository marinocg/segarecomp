diff -ru a/src/joystick/hidapi/SDL_hidapijoystick.c b/src/joystick/hidapi/SDL_hidapijoystick.c
--- a/src/joystick/hidapi/SDL_hidapijoystick.c	2026-10-15 20:06:09.766266251 +0200
+++ b/src/joystick/hidapi/SDL_hidapijoystick.c	2026-10-15 20:06:28.461719972 +0200
@@ -439,6 +439,27 @@
     return device;
 }
 
+// Segarecomp diagnostics (packaging/sdl-switch2-diagnostics.patch): SDL silently drops a device whose driver fails to initialise. For Nintendo Switch 2
+// controllers, record how far setup got and SDL's own error text, and publish it as a hint that the application can read.
+void HIDAPI_SegarecompTrace(SDL_HIDAPI_Device *device, const char *fmt, ...)
+{
+    char step[200], name[64];
+    size_t used;
+    va_list ap;
+
+    if (!device || device->vendor_id != USB_VENDOR_NINTENDO || device->product_id < 0x2066 || device->product_id > 0x2073) {
+        return;
+    }
+    va_start(ap, fmt);
+    SDL_vsnprintf(step, sizeof(step), fmt, ap);
+    va_end(ap);
+    used = SDL_strlen(device->segarecomp_trace);
+    SDL_snprintf(device->segarecomp_trace + used, sizeof(device->segarecomp_trace) - used, "%s%s", used ? " | " : "", step);
+    SDL_snprintf(name, sizeof(name), "SEGARECOMP_HIDAPI_SETUP_%04x_%04x", device->vendor_id, device->product_id);
+    SDL_SetHintWithPriority(name, device->segarecomp_trace, SDL_HINT_OVERRIDE);
+    SDL_LogDebug(SDL_LOG_CATEGORY_INPUT, "Switch 2 setup trace [%s]: %s", device->path ? device->path : "?", device->segarecomp_trace);
+}
+
 static void HIDAPI_CleanupDeviceDriver(SDL_HIDAPI_Device *device)
 {
     if (!device->driver) {
@@ -499,6 +520,8 @@
         return; // Already setup
     }
 
+    device->segarecomp_trace[0] = '\0';
+    HIDAPI_SegarecompTrace(device, "begin iface=%d class=%d usage_page=0x%04x usage=0x%04x bluetooth=%d", device->interface_number, device->interface_class, device->usage_page, device->usage, device->is_bluetooth);
     if (HIDAPI_GetDeviceDriver(device)) {
         // We might have a device driver for this device, try opening it and see
         if (device->num_children == 0) {
@@ -513,9 +536,11 @@
                 SDL_LogDebug(SDL_LOG_CATEGORY_INPUT,
                              "HIDAPI_SetupDeviceDriver() couldn't open %s: %s",
                              device->path, SDL_GetError());
+                HIDAPI_SegarecompTrace(device, "stage=open_path FAILED error=\"%s\"", SDL_GetError());
                 return;
             }
             SDL_hid_set_nonblocking(dev, 1);
+            HIDAPI_SegarecompTrace(device, "stage=open_path ok libusb_backed=%d", SDL_GetPointerProperty(SDL_hid_get_properties(dev), SDL_PROP_HIDAPI_LIBUSB_DEVICE_HANDLE_POINTER, NULL) != NULL);
 
             device->dev = dev;
         }
@@ -524,7 +549,10 @@
 
         // Initialize the device, which may cause a connected event
         if (device->driver && !device->driver->InitDevice(device)) {
+            HIDAPI_SegarecompTrace(device, "stage=init_device FAILED driver=%s error=\"%s\"", device->driver->name, SDL_GetError());
             HIDAPI_CleanupDeviceDriver(device);
+        } else if (device->driver) {
+            HIDAPI_SegarecompTrace(device, "stage=init_device ok driver=%s", device->driver->name);
         }
 
         if (!device->driver && device->dev) {
@@ -532,6 +560,12 @@
             SDL_hid_close(device->dev);
             device->dev = NULL;
         }
+    } else {
+#ifdef SDL_JOYSTICK_HIDAPI_SWITCH2
+        HIDAPI_SegarecompTrace(device, "stage=no_driver (switch2_driver_enabled=%d, ignored=%d, usage_filter_applies=%d)", SDL_HIDAPI_DriverSwitch2.enabled ? 1 : 0, SDL_ShouldIgnoreJoystick(device->vendor_id, device->product_id, device->version, device->name) ? 1 : 0, (device->usage_page != 0 && device->usage_page != 1) ? 1 : 0);
+#else
+        HIDAPI_SegarecompTrace(device, "stage=no_driver (switch2 driver not compiled)");
+#endif
     }
 }
 
