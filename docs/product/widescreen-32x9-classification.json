{
  "schema": "segarecomp.widescreen-classification",
  "schema_version": 1,
  "as_of": "2026-11-14",
  "basis": "Aggregate classes from bounded private runs (delivery F15, SEG-140-T006/T007). Contains no addresses, frames, captures, traces, tables or image bytes. The 16:9 packages are the baseline, not evidence for 21:9 or 32:9.",
