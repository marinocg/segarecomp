    "4:3",
    "16:9",
    "21:9",
    "32:9"
  ],
  "limitations": {
    "virtual_sprite_compositor": "tested C11 module (ADR 0303): command model, VDP decode, priority, clip and budget; consumed by the live Genesis viewer in the native picture and, in the presentation coordinate space, in the widescreen side columns the viewer presents (ADR 0306, 0307, F28); synthetic evidence only",
    "live_viewer_presents_virtual_sprites": true,
    "mod_can_author_virtual_sprites": true,
    "side_column_sprite_drawing": true,
    "actor_coverage_claims_available": [],
    "actors_coverage_in_reports": "a declared actors component is covered only by a composed virtual-sprite set that actually drew pixels into the presented frame (ADR 0304, ADR 0306); no shipped Sonic package submits one, so a declared actors component still reports missing there",
    "layered_overlays_count_as_hud": false,
    "scene_names_are_provider_claims": true,
    "follow_ups": [
      "per-title gameplay-changing window and object-loading changes in segarecomp-patches, only if the maintainer wants wider actor visibility"
    ]
  },
